{
  "name": "@relayward/ui-sdk",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Shared protocol types for sandboxed Relayward plugin pages",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
